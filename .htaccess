# DBS401 - Group 02 - Apache Security Config
# /var/www/html/dbs401-oracle-app/.htaccess

# ── Disable directory browsing ────────────────────────────
Options -Indexes

# ── Protect sensitive files ───────────────────────────────
<FilesMatch "^(config\.php|ANSWER_KEY\.md|ORACLE_PAYLOAD_CHEATSHEET\.md|\.env)$">
    Require all denied
</FilesMatch>

# ── Protect lab-only folders from direct web access ───────
# These hold solutions, writeups, provisioning scripts and infra manifests.
# None are served over HTTP: the app includes config.php etc. from the
# filesystem (__DIR__), never by URL. Blocking them stops students from
# reading the fixes (secure_versions/), the answer key (docs/) or running
# the provisioning scripts (database/*.php) straight from the browser.
RedirectMatch 403 ^/dbs401-oracle-app/(secure_versions|docs|tools|tests|k8s|database)(/|$)

# ── Protect database folder ───────────────────────────────
<FilesMatch "\.(sql)$">
    Require all denied
</FilesMatch>

# ── Block direct access to inc_ files ────────────────────
<FilesMatch "^inc_">
    Require all denied
</FilesMatch>

# ── PHP settings ──────────────────────────────────────────
# Hide PHP version in headers
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Default charset ───────────────────────────────────────
AddDefaultCharset UTF-8

# ── DirectoryIndex ────────────────────────────────────────
DirectoryIndex index.php
